# Copy this file to `.env` and fill in values as needed.
# `.env` is git-ignored - never commit real secrets.

# --- Application ---
APP_NAME=Strategy Research Lab
APP_ENVIRONMENT=development
APP_DEBUG=true

# --- Database ---
# Relative paths are resolved against the project root.
DATABASE_PATH=data/cache/state/strategy_research_lab.db
DATABASE_BUSY_TIMEOUT_SECONDS=30

# --- Logging ---
LOGGING_ROOT_DIR=logs
LOGGING_LEVEL=INFO
LOGGING_MAX_BYTES=5000000
LOGGING_BACKUP_COUNT=5
LOGGING_CONSOLE_OUTPUT=true

# --- Backtesting ---
BACKTESTING_DEFAULT_STARTING_CAPITAL=10000

# --- Experiments ---
EXPERIMENT_MAX_CONCURRENT=1
EXPERIMENT_MAX_PER_HOUR=20

# --- AI providers (provider-independent; set only what you use) ---
# none | mock | claude (alias: anthropic) | freebuff | ollama
AI_ACTIVE_PROVIDER=none
# Comma-separated provider names tried in order if the active one fails,
# e.g. "ollama,mock". Leave empty for no fallback.
AI_PROVIDER_FALLBACK_CHAIN=
# A fallback entry of "mock" is only ever used if this is true - set it
# only for explicit development/testing, never for real research.
AI_ALLOW_MOCK_FALLBACK=false

# Claude (Anthropic Messages API). Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Freebuff - provider is currently a structural placeholder only (no
# verified API contract was available to implement against; see
# app/ai/providers/freebuff.py). Setting these has no effect yet.
FREEBUFF_API_KEY=

# Local model server (e.g. Ollama). Not installed/managed by this
# project - see app/ai/providers/ollama.py for what "deferred runtime
# dependency" means here.
OLLAMA_BASE_URL=http://localhost:11434

# --- Supervisor ---
SUPERVISOR_ENABLED=false
SUPERVISOR_CHECK_INTERVAL_SECONDS=60
SUPERVISOR_MAX_AUTO_RESTART_ATTEMPTS=3

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# --- Risk ---
RISK_MAX_PER_TRADE_PCT=1.0
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_LIVE_TRADING_ENABLED=false
